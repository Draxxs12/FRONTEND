From 968dd69c6adf57b1103ffa3b658acec0963a06de Mon Sep 17 00:00:00 2001
From: Pruebas Sprint 4 <pruebas@local>
Date: Wed, 11 Nov 2026 21:06:15 +0000
Subject: [PATCH] ci: flujo de calidad del frontend y configuracion de
 SonarCloud (Sprint 4)

- calidad.yml: ng test (Vitest), npm audit y Gitleaks en cada Pull Request.
- sonar-project.properties: base para SonarCloud (reemplazar los valores TU_*).
---
 .github/workflows/calidad.yml | 28 ++++++++++++++++++++++++++++
 sonar-project.properties      |  6 ++++++
 2 files changed, 34 insertions(+)
 create mode 100644 .github/workflows/calidad.yml
 create mode 100644 sonar-project.properties

diff --git a/.github/workflows/calidad.yml b/.github/workflows/calidad.yml
new file mode 100644
index 0000000..0ba2e5d
--- /dev/null
+++ b/.github/workflows/calidad.yml
@@ -0,0 +1,28 @@
+name: Calidad frontend
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+
+jobs:
+  pruebas:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with: { node-version: 22, cache: npm }
+      - run: npm ci
+      - name: Pruebas unitarias (Vitest)
+        run: npx ng test --watch=false
+      - name: Vulnerabilidades de dependencias
+        run: npm audit --audit-level=high
+
+  secretos:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with: { fetch-depth: 0 }
+      - uses: gitleaks/gitleaks-action@v2
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
diff --git a/sonar-project.properties b/sonar-project.properties
new file mode 100644
index 0000000..1f4f592
--- /dev/null
+++ b/sonar-project.properties
@@ -0,0 +1,6 @@
+# SonarCloud (repositorio FRONTEND): reemplazar los valores TU_*.
+sonar.organization=TU_ORGANIZACION
+sonar.projectKey=TU_PROYECTO_FRONTEND
+sonar.sources=src/app
+sonar.test.inclusions=**/*.spec.ts
+sonar.exclusions=**/*.spec.ts
-- 
2.43.0

