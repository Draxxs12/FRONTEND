+++ b/src/app/Pages/devoluciones/devoluciones.component.spec.ts
@@ -0,0 +1,159 @@
+import { of, throwError } from 'rxjs';
+import { DevolucionesComponent } from './devoluciones.component';
+
+const venta = (id: number, estado: 'Completada' | 'Anulada' = 'Completada') => ({
+  id, numeroComprobante: `B001-${id}`, estado, total: 100, cliente: null, usuario: { id: 1, nombre: 'u' },
+  subtotal: 0, igv: 0, tipoPago: 'Efectivo', createdAt: '2026-10-01T10:00:00'
+});
+const linea = (productoId: number, cantidad: number, precio: number) => ({
+  id: productoId, producto: { id: productoId, nombre: 'P' + productoId, codigo: 'C' + productoId },
+  cantidad, precioUnitario: precio, subtotal: cantidad * precio
+});
+
+function crear(opts: { devoluciones?: any[]; ventas?: any[]; detalle?: any[] } = {}) {
+  const devolucionService: any = {
+    listar: vi.fn(() => of(opts.devoluciones ?? [])),
+    crear: vi.fn(() => of({}))
+  };
+  const ventaService: any = {
+    listar: vi.fn(() => of(opts.ventas ?? [])),
+    obtenerDetalle: vi.fn(() => of(opts.detalle ?? []))
+  };
+  const auth: any = { getUsuarioId: vi.fn(() => 7) };
+  const cdr: any = { detectChanges: vi.fn() };
+  const c = new DevolucionesComponent(devolucionService, ventaService, auth, cdr);
+  return { c, devolucionService, ventaService, auth };
+}
+
+beforeEach(() => { vi.useFakeTimers(); });
+afterEach(() => { vi.useRealTimers(); });
+
+describe('HU-S2-14 Listar devoluciones registradas', () => {
+  it('al abrir carga todas las devoluciones del servidor', () => {
+    const { c } = crear({ devoluciones: [{ id: 1, numeroNota: 'NC-001' }, { id: 2, numeroNota: 'NC-002' }] });
+    c.ngOnInit();
+    expect(c.devoluciones.length).toBe(2);
+  });
+  it('sin devoluciones el listado queda vacío sin error', () => {
+    const { c } = crear({ devoluciones: [] });
+    c.ngOnInit();
+    expect(c.devoluciones).toEqual([]);
+    expect(c.esError).toBe(false);
+  });
+  it('para devolver solo ofrece ventas Completadas (excluye las Anuladas)', () => {
+    const { c } = crear({ ventas: [venta(1), venta(2, 'Anulada'), venta(3)] });
+    c.ngOnInit();
+    expect(c.ventas.map(v => v.id)).toEqual([1, 3]);
+  });
+});
+
+describe('HU-S2-13 Registrar devolución (pantalla)', () => {
+  it('abrirNueva limpia el formulario y usa Efectivo por defecto', () => {
+    const { c } = crear();
+    c.motivo = 'viejo'; c.tipoReembolso = 'Tarjeta'; c.ventaSelId = 5;
+    c.abrirNueva();
+    expect(c.mostrarModal).toBe(true);
+    expect(c.ventaSelId).toBeNull();
+    expect(c.motivo).toBe('');
+    expect(c.tipoReembolso).toBe('Efectivo');
+    expect(c.lineas).toEqual([]);
+  });
+  it('sin venta elegida no hay líneas', () => {
+    const { c, ventaService } = crear();
+    c.ventaSelId = null; c.cargarDetalle();
+    expect(c.lineas).toEqual([]);
+    expect(ventaService.obtenerDetalle).not.toHaveBeenCalled();
+  });
+  it('al elegir una venta carga su detalle con cantidad a devolver en 0', () => {
+    const { c, ventaService } = crear({ detalle: [linea(1, 3, 10), linea(2, 1, 50)] });
+    c.ventaSelId = 9; c.cargarDetalle();
+    expect(ventaService.obtenerDetalle).toHaveBeenCalledWith(9);
+    expect(c.lineas.length).toBe(2);
+    expect(c.lineas.every(l => l.devolver === 0)).toBe(true);
+  });
+  it('totalReembolso es 0 mientras no se indique ninguna cantidad', () => {
+    const { c } = crear({ detalle: [linea(1, 3, 10)] });
+    c.ventaSelId = 9; c.cargarDetalle();
+    expect(c.totalReembolso).toBe(0);
+  });
+  it('totalReembolso suma cantidad x precio solo de las líneas a devolver', () => {
+    const { c } = crear({ detalle: [linea(1, 3, 10), linea(2, 4, 50)] });
+    c.ventaSelId = 9; c.cargarDetalle();
+    c.lineas[0].devolver = 2;      // 20
+    c.lineas[1].devolver = 0;      // no cuenta
+    expect(c.totalReembolso).toBe(20);
+  });
+  it('una cantidad negativa no resta del reembolso', () => {
+    const { c } = crear({ detalle: [linea(1, 3, 10)] });
+    c.ventaSelId = 9; c.cargarDetalle();
+    c.lineas[0].devolver = -5;
+    expect(c.totalReembolso).toBe(0);
+  });
+  it('sin venta seleccionada no registra y avisa', () => {
+    const { c, devolucionService } = crear();
+    c.ventaSelId = null;
+    c.registrar();
+    expect(devolucionService.crear).not.toHaveBeenCalled();
+    expect(c.esError).toBe(true);
+    expect(c.mensaje).toBe('Selecciona una venta e indica cantidades a devolver.');
+  });
+  it('con todas las cantidades en 0 no registra (valor límite)', () => {
+    const { c, devolucionService } = crear({ detalle: [linea(1, 3, 10)] });
+    c.ventaSelId = 9; c.cargarDetalle();
+    c.registrar();
+    expect(devolucionService.crear).not.toHaveBeenCalled();
+  });
+  it('envía solo las líneas con cantidad > 0, con usuario, venta, motivo y tipo de reembolso', () => {
+    const { c, devolucionService } = crear({ detalle: [linea(1, 3, 10), linea(2, 4, 50)] });
+    c.ventaSelId = 9; c.cargarDetalle();
+    c.lineas[0].devolver = 1; c.motivo = 'Defectuoso'; c.tipoReembolso = 'Tarjeta';
+    c.registrar();
+    expect(devolucionService.crear).toHaveBeenCalledWith({
+      usuarioId: 7, ventaId: 9, motivo: 'Defectuoso', tipoReembolso: 'Tarjeta',
+      detalles: [{ producto: { id: 1 }, cantidad: 1, precioUnitario: 10 }]
+    });
+  });
+  it('devolver exactamente lo vendido se envía (valor límite)', () => {
+    const { c, devolucionService } = crear({ detalle: [linea(1, 3, 10)] });
+    c.ventaSelId = 9; c.cargarDetalle();
+    c.lineas[0].devolver = 3;
+    c.registrar();
+    expect(devolucionService.crear).toHaveBeenCalledTimes(1);
+  });
+  it('registro exitoso: cierra el modal, recarga y confirma', () => {
+    const { c, devolucionService } = crear({ detalle: [linea(1, 3, 10)] });
+    c.ventaSelId = 9; c.cargarDetalle(); c.abrirNueva(); c.ventaSelId = 9; c.cargarDetalle();
+    c.lineas[0].devolver = 1;
+    const cargas = devolucionService.listar.mock.calls.length;
+    c.registrar();
+    expect(c.mostrarModal).toBe(false);
+    expect(c.esError).toBe(false);
+    expect(c.mensaje).toBe('Devolución registrada.');
+    expect(devolucionService.listar.mock.calls.length).toBe(cargas + 1);
+  });
+  it('si el servidor rechaza, muestra el texto que devuelve', () => {
+    const { c, devolucionService } = crear({ detalle: [linea(1, 3, 10)] });
+    devolucionService.crear.mockReturnValue(throwError(() => ({ error: 'No se puede devolver más de lo vendido' })));
+    c.ventaSelId = 9; c.cargarDetalle(); c.lineas[0].devolver = 1;
+    c.registrar();
+    expect(c.esError).toBe(true);
+    expect(c.mensaje).toBe('No se puede devolver más de lo vendido');
+  });
+  it('si el error no trae texto usa el mensaje genérico', () => {
+    const { c, devolucionService } = crear({ detalle: [linea(1, 3, 10)] });
+    devolucionService.crear.mockReturnValue(throwError(() => ({ status: 500 })));
+    c.ventaSelId = 9; c.cargarDetalle(); c.lineas[0].devolver = 1;
+    c.registrar();
+    expect(c.mensaje).toBe('Error al registrar.');
+  });
+
+  // ROJO ESPERADO: hoy la validación "no más de lo vendido" solo existe en el servidor.
+  // La pantalla deja enviar 5 unidades de una venta de 3. Decidir: validar también en pantalla o descartar este caso.
+  it('ROJO esperado: devolver más de lo vendido no se envía al servidor', () => {
+    const { c, devolucionService } = crear({ detalle: [linea(1, 3, 10)] });
+    c.ventaSelId = 9; c.cargarDetalle();
+    c.lineas[0].devolver = 5;
+    c.registrar();
+    expect(devolucionService.crear).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/app/Pages/layout/permisos.spec.ts b/src/app/Pages/layout/permisos.spec.ts
new file mode 100644
index 0000000..44000f5
--- /dev/null
+++ b/src/app/Pages/layout/permisos.spec.ts
@@ -0,0 +1,152 @@
+import { Subject } from 'rxjs';
+import { NavigationEnd } from '@angular/router';
+import { TestBed } from '@angular/core/testing';
+import { Router } from '@angular/router';
+import { LayoutComponent } from './layout.component';
+import { puede, rutasDe, primeraRuta, PERMISOS } from '../../Settings/permisos';
+import { rolGuard } from '../../Guards/rol.guard';
+import { AuthService } from '../../Services/auth.service';
+
+/**
+ * HU-S2-07 (H0026) Navegación rápida desde el dashboard.
+ * La navegación del sistema vive en el menú lateral (LayoutComponent) y se
+ * filtra por rol con permisos.ts. Estas pruebas verifican qué accesos ve cada rol.
+ */
+describe('HU-S2-07 Permisos por rol (qué accesos ve cada usuario)', () => {
+  it('el Administrador entra a todas las rutas', () => {
+    expect(puede('Administrador', 'usuarios')).toBe(true);
+    expect(puede('Administrador', 'stock')).toBe(true);
+    expect(puede('Administrador', 'ruta-que-no-existe')).toBe(true);
+  });
+  it('el Recepcionista entra a ventas y caja', () => {
+    expect(puede('Recepcionista', 'punto-de-venta')).toBe(true);
+    expect(puede('Recepcionista', 'historial-ventas')).toBe(true);
+    expect(puede('Recepcionista', 'caja')).toBe(true);
+  });
+  it('el Recepcionista NO entra a inventario ni administración', () => {
+    expect(puede('Recepcionista', 'productos')).toBe(false);
+    expect(puede('Recepcionista', 'stock')).toBe(false);
+    expect(puede('Recepcionista', 'usuarios')).toBe(false);
+  });
+  it('el Almacenero entra a inventario y abastecimiento', () => {
+    expect(puede('Almacenero', 'productos')).toBe(true);
+    expect(puede('Almacenero', 'categorias')).toBe(true);
+    expect(puede('Almacenero', 'stock')).toBe(true);
+    expect(puede('Almacenero', 'compras')).toBe(true);
+  });
+  it('el Almacenero NO entra al punto de venta ni a caja', () => {
+    expect(puede('Almacenero', 'punto-de-venta')).toBe(false);
+    expect(puede('Almacenero', 'caja')).toBe(false);
+  });
+  it('todos los roles definidos pueden entrar al dashboard', () => {
+    Object.keys(PERMISOS).forEach(rol => expect(puede(rol, 'dashboard')).toBe(true));
+  });
+  it('un rol desconocido o sin rol solo ve el dashboard (valor límite)', () => {
+    expect(rutasDe('Invitado')).toEqual(['dashboard']);
+    expect(rutasDe(null)).toEqual(['dashboard']);
+    expect(puede(null, 'dashboard')).toBe(true);
+    expect(puede(null, 'ventas')).toBe(false);
+  });
+  it('primeraRuta manda al Administrador al dashboard', () => {
+    expect(primeraRuta('Administrador')).toBe('dashboard');
+  });
+  it('primeraRuta manda a cada rol a su primera pantalla permitida', () => {
+    expect(primeraRuta('Recepcionista')).toBe('dashboard');
+    expect(primeraRuta('Almacenero')).toBe('dashboard');
+    expect(primeraRuta(null)).toBe('dashboard');
+  });
+});
+
+describe('HU-S2-07 Guard de rutas (rolGuard)', () => {
+  function evaluar(rol: string | null, path: string) {
+    const router: any = { navigate: vi.fn() };
+    const auth: any = { getRol: () => rol };
+    TestBed.configureTestingModule({
+      providers: [{ provide: AuthService, useValue: auth }, { provide: Router, useValue: router }]
+    });
+    const permitido = TestBed.runInInjectionContext(
+      () => rolGuard({ routeConfig: { path } } as any, {} as any));
+    return { permitido, router };
+  }
+
+  it('deja pasar si el rol tiene permiso', () => {
+    const { permitido, router } = evaluar('Almacenero', 'stock');
+    expect(permitido).toBe(true);
+    expect(router.navigate).not.toHaveBeenCalled();
+  });
+  it('bloquea y redirige si el rol no tiene permiso', () => {
+    const { permitido, router } = evaluar('Recepcionista', 'usuarios');
+    expect(permitido).toBe(false);
+    expect(router.navigate).toHaveBeenCalledWith(['/dashboard']);
+  });
+});
+
+describe('HU-S2-07 Menú lateral (LayoutComponent)', () => {
+  function crear(rol: string, nombre = 'dany baca') {
+    const events = new Subject<any>();
+    const router: any = { events, navigate: vi.fn() };
+    const route: any = { firstChild: null, snapshot: { data: {} } };
+    const auth: any = { getNombre: () => nombre, getRol: () => rol, logout: vi.fn() };
+    const cdr: any = { detectChanges: vi.fn() };
+    const c = new LayoutComponent(auth, router, route, cdr);
+    c.ngOnInit();
+    return { c, auth, router, route, events };
+  }
+
+  it('toma el nombre, el rol y la inicial en mayúscula del usuario', () => {
+    const { c } = crear('Almacenero', 'dany baca');
+    expect(c.nombre).toBe('dany baca');
+    expect(c.rol).toBe('Almacenero');
+    expect(c.inicial).toBe('D');
+  });
+  it('sin nombre usa "Usuario"', () => {
+    const { c } = crear('Almacenero', '');
+    expect(c.nombre).toBe('Usuario');
+    expect(c.inicial).toBe('U');
+  });
+  it('el Administrador ve todos los grupos del menú', () => {
+    const { c } = crear('Administrador');
+    expect(c.grupoVentas()).toBe(true);
+    expect(c.grupoInventario()).toBe(true);
+    expect(c.grupoAbastecimiento()).toBe(true);
+    expect(c.grupoAdmin()).toBe(true);
+  });
+  it('el Almacenero ve Inventario y Abastecimiento, no Ventas ni Administración', () => {
+    const { c } = crear('Almacenero');
+    expect(c.grupoInventario()).toBe(true);
+    expect(c.grupoAbastecimiento()).toBe(true);
+    expect(c.grupoVentas()).toBe(false);
+    expect(c.grupoAdmin()).toBe(false);
+  });
+  it('el Recepcionista ve Ventas, no Inventario', () => {
+    const { c } = crear('Recepcionista');
+    expect(c.grupoVentas()).toBe(true);
+    expect(c.grupoInventario()).toBe(false);
+  });
+  it('toggle abre y cierra un grupo desplegable', () => {
+    const { c } = crear('Administrador');
+    expect(c.grupos.ventas).toBe(true);
+    c.toggle('ventas');
+    expect(c.grupos.ventas).toBe(false);
+    c.toggle('ventas');
+    expect(c.grupos.ventas).toBe(true);
+  });
+  it('al navegar, el título de la sección sale de la ruta activa', () => {
+    const { c, route, events } = crear('Administrador');
+    (route as any).firstChild = { firstChild: null, snapshot: { data: { titulo: 'Inventario' } } };
+    events.next(new NavigationEnd(1, '/stock', '/stock'));
+    expect(c.tituloSeccion).toBe('Inventario');
+  });
+  it('si la ruta no trae título usa "Dashboard"', () => {
+    const { c, route, events } = crear('Administrador');
+    (route as any).firstChild = { firstChild: null, snapshot: { data: {} } };
+    events.next(new NavigationEnd(2, '/x', '/x'));
+    expect(c.tituloSeccion).toBe('Dashboard');
+  });
+  it('salir cierra la sesión y vuelve al login', () => {
+    const { c, auth, router } = crear('Administrador');
+    c.salir();
+    expect(auth.logout).toHaveBeenCalled();
+    expect(router.navigate).toHaveBeenCalledWith(['/login']);
+  });
+});
diff --git a/src/app/Pages/productos/productos.component.spec.ts b/src/app/Pages/productos/productos.component.spec.ts
