diff --git a/src/app/Pages/categorias/categorias.component.spec.ts b/src/app/Pages/categorias/categorias.component.spec.ts
new file mode 100644
index 0000000..0895544
--- /dev/null
+++ b/src/app/Pages/categorias/categorias.component.spec.ts
@@ -0,0 +1,175 @@
+import { of, throwError } from 'rxjs';
+import { CategoriasComponent } from './categorias.component';
+
+const prod = (id: number, catId: number | null) => ({
+  id, codigo: 'C' + id, nombre: 'P' + id,
+  categoria: catId == null ? null : { id: catId, nombre: 'Cat' + catId },
+  precioCompra: 1, precioVenta: 2, stock: 1, stockMinimo: 1, activo: true
+});
+
+function crear(categorias: any[] = [], productos: any[] = []) {
+  const categoriaService: any = {
+    listar: vi.fn(() => of(categorias)),
+    crear: vi.fn(() => of({})),
+    actualizar: vi.fn(() => of({})),
+    eliminar: vi.fn(() => of({}))
+  };
+  const productoService: any = { listar: vi.fn(() => of(productos)) };
+  const cdr: any = { detectChanges: vi.fn() };
+  const c = new CategoriasComponent(categoriaService, productoService, cdr);
+  return { c, categoriaService, productoService };
+}
+
+beforeEach(() => { vi.useFakeTimers(); });
+afterEach(() => { vi.useRealTimers(); vi.unstubAllGlobals(); });
+
+describe('HU-S2-18 Listar categorías', () => {
+  it('al abrir carga todas las categorías y los productos', () => {
+    const { c } = crear([{ id: 1, nombre: 'A' }, { id: 2, nombre: 'B' }], [prod(1, 1)]);
+    c.ngOnInit();
+    expect(c.categorias.length).toBe(2);
+    expect(c.productos.length).toBe(1);
+  });
+  it('sin categorías el listado queda vacío', () => {
+    const { c } = crear([]); c.ngOnInit();
+    expect(c.categorias).toEqual([]);
+  });
+  it('productosDe devuelve solo los productos de esa categoría', () => {
+    const { c } = crear([], [prod(1, 1), prod(2, 2), prod(3, 1), prod(4, null)]); c.ngOnInit();
+    expect(c.productosDe(1).map(p => p.id)).toEqual([1, 3]);
+  });
+  it('productosDe sin id devuelve lista vacía', () => {
+    const { c } = crear([], [prod(1, 1)]); c.ngOnInit();
+    expect(c.productosDe(undefined)).toEqual([]);
+  });
+  it('toggleExpandir abre una categoría y la cierra al repetir', () => {
+    const { c } = crear();
+    c.toggleExpandir(3); expect(c.expandida).toBe(3);
+    c.toggleExpandir(3); expect(c.expandida).toBeNull();
+  });
+  it('al expandir otra categoría se cierra la anterior', () => {
+    const { c } = crear();
+    c.toggleExpandir(1); c.toggleExpandir(2);
+    expect(c.expandida).toBe(2);
+  });
+});
+
+describe('HU-S2-19 Registrar nueva categoría', () => {
+  it('abrirNuevo muestra el modal con el formulario vacío', () => {
+    const { c } = crear(); c.form = { id: 4, nombre: 'viejo' }; c.abrirNuevo();
+    expect(c.mostrarModal).toBe(true);
+    expect(c.modoEdicion).toBe(false);
+    expect(c.form).toEqual({ nombre: '' });
+  });
+  it('nombre vacío no guarda y avisa', () => {
+    const { c, categoriaService } = crear(); c.abrirNuevo(); c.form.nombre = '';
+    c.guardar();
+    expect(categoriaService.crear).not.toHaveBeenCalled();
+    expect(c.mensaje).toBe('El nombre es obligatorio.');
+    expect(c.esError).toBe(true);
+  });
+  it('nombre con solo espacios no guarda (valor límite)', () => {
+    const { c, categoriaService } = crear(); c.abrirNuevo(); c.form.nombre = '   ';
+    c.guardar();
+    expect(categoriaService.crear).not.toHaveBeenCalled();
+  });
+  it('nombre de 1 carácter es válido (valor límite)', () => {
+    const { c, categoriaService } = crear(); c.abrirNuevo(); c.form.nombre = 'A';
+    c.guardar();
+    expect(categoriaService.crear).toHaveBeenCalledWith({ nombre: 'A' });
+  });
+  it('categoría válida: crea, cierra el modal, recarga y confirma', () => {
+    const { c, categoriaService } = crear(); c.abrirNuevo(); c.form.nombre = 'Pinturas';
+    const cargas = categoriaService.listar.mock.calls.length;
+    c.guardar();
+    expect(categoriaService.crear).toHaveBeenCalledWith({ nombre: 'Pinturas' });
+    expect(categoriaService.actualizar).not.toHaveBeenCalled();
+    expect(c.mostrarModal).toBe(false);
+    expect(c.mensaje).toBe('Categoría guardada.');
+    expect(c.esError).toBe(false);
+    expect(categoriaService.listar.mock.calls.length).toBe(cargas + 1);
+  });
+  it('si el servidor falla (por ejemplo nombre repetido) muestra el error', () => {
+    const { c, categoriaService } = crear(); c.abrirNuevo(); c.form.nombre = 'Pinturas';
+    categoriaService.crear.mockReturnValue(throwError(() => ({ status: 500 })));
+    c.guardar();
+    expect(c.esError).toBe(true);
+    expect(c.mensaje).toBe('Error al guardar.');
+  });
+  it('el mensaje de confirmación desaparece a los 4 segundos (valor límite)', () => {
+    const { c } = crear(); c.abrirNuevo(); c.form.nombre = 'Pinturas';
+    c.guardar();
+    vi.advanceTimersByTime(3999); expect(c.mensaje).not.toBe('');
+    vi.advanceTimersByTime(1);    expect(c.mensaje).toBe('');
+  });
+
+  // ROJO ESPERADO: la pantalla valida con trim() pero luego envía el nombre sin recortar,
+  // así que "  Pinturas " queda guardado con espacios. Corrección sugerida: enviar this.form.nombre.trim().
+  it('ROJO esperado: el nombre se guarda sin espacios sobrantes', () => {
+    const { c, categoriaService } = crear(); c.abrirNuevo(); c.form.nombre = '  Pinturas ';
+    c.guardar();
+    expect(categoriaService.crear).toHaveBeenCalledWith({ nombre: 'Pinturas' });
+  });
+});
+
+describe('HU-S2-20 Editar categoría', () => {
+  it('abrirEditar carga una copia de la categoría en el formulario', () => {
+    const { c } = crear(); const original = { id: 2, nombre: 'Pinturas' };
+    c.abrirEditar(original);
+    expect(c.modoEdicion).toBe(true);
+    expect(c.form).toEqual(original);
+    expect(c.form).not.toBe(original);          // es copia: cancelar no altera el listado
+  });
+  it('guardar en edición actualiza la categoría, no crea otra', () => {
+    const { c, categoriaService } = crear(); c.abrirEditar({ id: 2, nombre: 'Pinturas' });
+    c.form.nombre = 'Pinturas y barnices';
+    c.guardar();
+    expect(categoriaService.actualizar).toHaveBeenCalledWith(2, { id: 2, nombre: 'Pinturas y barnices' });
+    expect(categoriaService.crear).not.toHaveBeenCalled();
+    expect(c.mensaje).toBe('Categoría guardada.');
+  });
+  it('editar dejando el nombre vacío se rechaza', () => {
+    const { c, categoriaService } = crear(); c.abrirEditar({ id: 2, nombre: 'Pinturas' });
+    c.form.nombre = '';
+    c.guardar();
+    expect(categoriaService.actualizar).not.toHaveBeenCalled();
+    expect(c.mensaje).toBe('El nombre es obligatorio.');
+  });
+  it('cerrar oculta el modal sin guardar', () => {
+    const { c, categoriaService } = crear(); c.abrirEditar({ id: 2, nombre: 'X' });
+    c.cerrar();
+    expect(c.mostrarModal).toBe(false);
+    expect(categoriaService.actualizar).not.toHaveBeenCalled();
+  });
+});
+
+describe('H0054 Eliminar categoría', () => {
+  it('si se cancela la confirmación no elimina', () => {
+    vi.stubGlobal('confirm', () => false);
+    const { c, categoriaService } = crear();
+    c.eliminar({ id: 1, nombre: 'A' });
+    expect(categoriaService.eliminar).not.toHaveBeenCalled();
+  });
+  it('confirmado: elimina y recarga', () => {
+    vi.stubGlobal('confirm', () => true);
+    const { c, categoriaService } = crear();
+    const cargas = categoriaService.listar.mock.calls.length;
+    c.eliminar({ id: 1, nombre: 'A' });
+    expect(categoriaService.eliminar).toHaveBeenCalledWith(1);
+    expect(categoriaService.listar.mock.calls.length).toBe(cargas + 1);
+  });
+  it('si tiene productos asociados avisa que no se pudo eliminar', () => {
+    vi.stubGlobal('confirm', () => true);
+    const { c, categoriaService } = crear();
+    categoriaService.eliminar.mockReturnValue(throwError(() => ({ status: 409 })));
+    c.eliminar({ id: 1, nombre: 'A' });
+    expect(c.esError).toBe(true);
+    expect(c.mensaje).toContain('No se pudo eliminar');
+  });
+  it('una categoría sin id no se intenta eliminar', () => {
+    vi.stubGlobal('confirm', () => true);
+    const { c, categoriaService } = crear();
+    c.eliminar({ nombre: 'sin id' });
+    expect(categoriaService.eliminar).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/app/Pages/dashboard/dashboard.graficos.spec.ts b/src/app/Pages/dashboard/dashboard.graficos.spec.ts
new file mode 100644
index 0000000..6e91de7
--- /dev/null
+++ b/src/app/Pages/dashboard/dashboard.graficos.spec.ts
@@ -0,0 +1,132 @@
+import { of } from 'rxjs';
+import { DashboardComponent } from './dashboard.component';
+
+const p2 = (n: number) => String(n).padStart(2, '0');
+const fecha = (d: Date) => `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
+const haceDias = (n: number) => { const d = new Date(); d.setDate(d.getDate() - n); return fecha(d); };
+
+interface Datos { productos?: any[]; clientes?: any[]; ventas?: any[]; compras?: any[]; }
+
+function crear(datos: Datos = {}) {
+  const ps: any = { listar: vi.fn(() => of(datos.productos ?? [])) };
+  const cs: any = { getAll: vi.fn(() => of(datos.clientes ?? [])) };
+  const vs: any = { listar: vi.fn(() => of(datos.ventas ?? [])), topClientes: vi.fn(() => of([])) };
+  const cps: any = { getAll: vi.fn(() => of(datos.compras ?? [])) };
+  const cdr: any = { detectChanges: vi.fn() };
+  const c = new DashboardComponent(ps, cs, vs, cps, cdr);
+  c.ngOnInit();
+  return c;
+}
+
+const serie = (o: any): any[] => (o.series as any[])[0].data;
+
+describe('H0020 KPIs sin datos (CP-002)', () => {
+  it('con todo vacío los indicadores quedan en 0 y no hay error', () => {
+    const c = crear();
+    expect(c.totalProductos).toBe(0);
+    expect(c.totalStockBajo).toBe(0);
+    expect(c.totalClientes).toBe(0);
+    expect(c.ventasHoy).toBe(0);
+  });
+});
+
+describe('H0021 Tendencia de ventas semanal (CP-003, CP-004)', () => {
+  it('la serie tiene 7 días y el último es hoy', () => {
+    const c = crear({ ventas: [
+      { estado: 'Completada', total: 100, createdAt: haceDias(0) + 'T09:00:00' },
+      { estado: 'Completada', total: 40.5, createdAt: haceDias(0) + 'T18:00:00' },
+    ]});
+    const datos = serie(c.mainLineChartOptions);
+    expect(datos.length).toBe(7);
+    expect(datos[6]).toBe(140.5);
+  });
+  it('un día sin ventas aparece con 0', () => {
+    const c = crear({ ventas: [{ estado: 'Completada', total: 80, createdAt: haceDias(2) + 'T10:00:00' }] });
+    const datos = serie(c.mainLineChartOptions);
+    expect(datos[4]).toBe(80);   // hace 2 días
+    expect(datos[5]).toBe(0);    // ayer, sin ventas
+    expect(datos[6]).toBe(0);    // hoy, sin ventas
+  });
+  it('las ventas anuladas no cuentan', () => {
+    const c = crear({ ventas: [
+      { estado: 'Anulada', total: 999, createdAt: haceDias(0) + 'T10:00:00' },
+      { estado: 'Completada', total: 10, createdAt: haceDias(0) + 'T11:00:00' },
+    ]});
+    expect(serie(c.mainLineChartOptions)[6]).toBe(10);
+  });
+  it('las ventas de hace más de 7 días quedan fuera', () => {
+    const c = crear({ ventas: [{ estado: 'Completada', total: 500, createdAt: haceDias(7) + 'T10:00:00' }] });
+    expect(serie(c.mainLineChartOptions).every((v: number) => v === 0)).toBe(true);
+  });
+});
+
+describe('H0022 Top proveedores (CP-005, CP-006, CP-007)', () => {
+  const compra = (empresa: string, total: number) => ({ proveedor: { empresa }, total });
+
+  it('suma las compras por proveedor y ordena de mayor a menor', () => {
+    const c = crear({ compras: [compra('A', 100), compra('B', 500), compra('A', 150)] });
+    const nombres = (c.proveedoresChartOptions.yAxis as any).data;
+    const valores = serie(c.proveedoresChartOptions).map((d: any) => d.value);
+    expect(nombres).toEqual(['B', 'A']);
+    expect(valores).toEqual([500, 250]);
+  });
+  it('muestra como máximo 5 proveedores (valor límite)', () => {
+    const compras = ['A', 'B', 'C', 'D', 'E', 'F', 'G'].map((n, i) => compra(n, (i + 1) * 100));
+    const c = crear({ compras });
+    expect((c.proveedoresChartOptions.yAxis as any).data).toEqual(['G', 'F', 'E', 'D', 'C']);
+  });
+  it('exactamente 5 proveedores se muestran todos', () => {
+    const c = crear({ compras: ['A', 'B', 'C', 'D', 'E'].map((n, i) => compra(n, (i + 1) * 10)) });
+    expect((c.proveedoresChartOptions.yAxis as any).data.length).toBe(5);
+  });
+  it('sin compras la lista queda con un aviso y valor 0, sin error', () => {
+    const c = crear();
+    expect((c.proveedoresChartOptions.yAxis as any).data).toEqual(['Sin compras registradas']);
+    expect(serie(c.proveedoresChartOptions)[0].value).toBe(0);
+  });
+  it('ignora las compras sin proveedor o sin total', () => {
+    const c = crear({ compras: [{ proveedor: null, total: 100 }, compra('A', 0), compra('B', 70)] });
+    expect((c.proveedoresChartOptions.yAxis as any).data).toEqual(['B']);
+  });
+});
+
+describe('H0023 Productos por categoría (CP-008, CP-009)', () => {
+  const prod = (id: number, cat: string | null, activo = true) =>
+    ({ id, activo, stock: 10, stockMinimo: 1, categoria: cat ? { nombre: cat } : null });
+
+  it('cuenta los productos activos de cada categoría', () => {
+    const c = crear({ productos: [prod(1, 'Herramientas'), prod(2, 'Herramientas'), prod(3, 'Pinturas')] });
+    expect((c.barChartOptions.xAxis as any).data).toEqual(['Herramientas', 'Pinturas']);
+    expect(serie(c.barChartOptions)).toEqual([2, 1]);
+  });
+  it('los productos inactivos no cuentan', () => {
+    const c = crear({ productos: [prod(1, 'Herramientas'), prod(2, 'Herramientas', false)] });
+    expect(serie(c.barChartOptions)).toEqual([1]);
+  });
+  it('un producto sin categoría se omite (regla actual)', () => {
+    const c = crear({ productos: [prod(1, null), prod(2, 'Pinturas')] });
+    expect((c.barChartOptions.xAxis as any).data).toEqual(['Pinturas']);
+  });
+  it('sin productos muestra "Sin productos" con valor 0', () => {
+    const c = crear();
+    expect((c.barChartOptions.xAxis as any).data).toEqual(['Sin productos']);
+    expect(serie(c.barChartOptions)).toEqual([0]);
+  });
+});
+
+describe('H0025 Evolución de ventas y compras (CP-013, CP-014)', () => {
+  it('la mini serie de compras tiene 4 días y el último es hoy', () => {
+    const c = crear({ compras: [{ proveedor: { empresa: 'A' }, total: 300, createdAt: haceDias(0) + 'T10:00:00' }] });
+    const datos = serie(c.miniLineComprasOptions);
+    expect(datos.length).toBe(4);
+    expect(datos[3]).toBe(300);
+  });
+  it('un periodo sin compras marca 0', () => {
+    const c = crear({ compras: [{ proveedor: { empresa: 'A' }, total: 300, createdAt: haceDias(3) + 'T10:00:00' }] });
+    expect(serie(c.miniLineComprasOptions)).toEqual([300, 0, 0, 0]);
+  });
+  it('la mini serie de ventas toma los últimos 4 días de la semana', () => {
+    const c = crear({ ventas: [{ estado: 'Completada', total: 25, createdAt: haceDias(1) + 'T10:00:00' }] });
+    expect(serie(c.miniLineVentasOptions)).toEqual([0, 0, 25, 0]);
+  });
+});
diff --git a/src/app/Pages/devoluciones/devoluciones.component.spec.ts b/src/app/Pages/devoluciones/devoluciones.component.spec.ts
new file mode 100644
index 0000000..620242a
